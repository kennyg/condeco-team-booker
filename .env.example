# Example environment variables for CI/CD or alternative authentication

# Alternative to keyring storage - use for CI/CD
CONDECO_TOKEN=your_jwt_token_here

# Condeco configuration (can also be passed as CLI arguments)
CONDECO_UNIQUE_KEY=your-company.condecosoftware.com
CONDECO_LOCATION_ID=LOC001
CONDECO_GROUP_ID=GRP001
CONDECO_USER_ID=USR001
CONDECO_FLOOR_ID=FLR001